<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>JevChatAnalyzer.Core</RootNamespace>
    <Description>微信 4.x 数据库直读的 Jev 聊天判读核心库</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="libtorch-cpu-win-x64" Version="2.10.0" />

    <PackageReference Include="NLaya" Version="1.0.0" />
    <PackageReference Include="NLaya.TorchSharp" Version="1.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />

    <PackageReference Include="TorchSharp" Version="0.107.0" />
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="1.13.8" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="JevChatAnalyzer.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\native\rwk\rwk.dll" Link="rwk.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\native\sqlcipher\sqlcipher.dll" Link="sqlcipher.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\native\silk\silk_decoder.dll" Link="silk_decoder.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
