<Page
    x:Class="JevChatAnalyzer.App.Views.SettingsPage"
    NavigationCacheMode="Required"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧 Tab 分区 -->
        <ListView Grid.Column="0" x:Name="TabList" SelectionChanged="TabList_SelectionChanged">
            <ListViewItem Tag="keys" IsSelected="True">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE192;" FontSize="16" /><TextBlock Text="微信密钥" />
                </StackPanel>
            </ListViewItem>
            <ListViewItem Tag="models">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8D6;" FontSize="16" /><TextBlock Text="本地 laya 判读" />
                </StackPanel>
            </ListViewItem>
            <ListViewItem Tag="voice">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE720;" FontSize="16" /><TextBlock Text="语音转写" />
                </StackPanel>
            </ListViewItem>
            <ListViewItem Tag="draft">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8BD;" FontSize="16" /><TextBlock Text="起草回复" />
                </StackPanel>
            </ListViewItem>
            <ListViewItem Tag="privacy">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72E;" FontSize="16" /><TextBlock Text="隐私与写回" />
                </StackPanel>
            </ListViewItem>
            <ListViewItem Tag="about">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE946;" FontSize="16" /><TextBlock Text="关于" />
                </StackPanel>
            </ListViewItem>
        </ListView>

        <ScrollViewer Grid.Column="1" Margin="16,0,0,0">
            <StackPanel Spacing="12">

                <!--  密钥  -->
                <StackPanel x:Name="PaneKeys" Spacing="12">
                    <TextBlock FontSize="20" FontWeight="SemiBold">微信密钥</TextBlock>
                    <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="自动读取通过 rwk.dll 对已登录微信做只读内存扫描（不注入、不写入）。密钥以 DPAPI 加密保存在本机，与当前 Windows 用户绑定。" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Padding="12,0" x:Name="AutoReadButton" Height="32" Click="AutoRead_Click">自动读取（需微信登录）</Button>
                        <Button Padding="12,0" x:Name="ManualSaveButton" Height="32" Click="ManualSave_Click">保存手动输入</Button>
                        <Button Padding="12,0" x:Name="ElevateButton" Height="32" Click="Elevate_Click"
                                Visibility="Collapsed" ToolTipService.ToolTip="微信以管理员身份运行时，读取密钥需要同等权限">
                            以管理员身份重启
                        </Button>
                    </StackPanel>
                    <TextBlock Text="账号" FontWeight="SemiBold" />
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8"
                            BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
                        <ListView x:Name="AccountList" SelectionMode="None" MaxHeight="220"
                                  ScrollViewer.HorizontalScrollMode="Disabled"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="MinHeight" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="10,8" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="32" Height="32" CornerRadius="6"
                                                Background="{Binding AvatarBrush}"
                                                VerticalAlignment="Center">
                                            <Grid>
                                                <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="14"
                                                           FontWeight="SemiBold" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                                <Image Source="{Binding AvatarImage}" Stretch="UniformToFill"
                                                       Visibility="{Binding AvatarVisibility}" />
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="{Binding ActionLabel}"
                                                Click="AccountConnect_Click"
                                                VerticalAlignment="Center" Height="32" MinWidth="64" Padding="12,0"
                                                FontSize="12" />
                                        <Button Grid.Column="3" Click="AccountEdit_Click" VerticalAlignment="Center"
                                                Width="32" Height="32" Padding="0" Background="Transparent"
                                                BorderThickness="0"
                                                ToolTipService.ToolTip="编辑账号（昵称 / 数据目录）">
                                            <FontIcon Glyph="&#xE70F;" FontSize="14" />
                                        </Button>
                                        <Button Grid.Column="4" Click="AccountDelete_Click" VerticalAlignment="Center"
                                                Width="32" Height="32" Padding="0" FontSize="12"
                                                Background="Transparent" BorderThickness="0"
                                                ToolTipService.ToolTip="从保管库删除该账号">
                                            <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                    <TextBlock x:Name="AccountHint" FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <StackPanel Spacing="4">
                        <TextBlock>wxid</TextBlock>
                        <TextBox x:Name="ManualWxId" PlaceholderText="wxid_xxxx" />
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock>dbKey（64 位 hex）</TextBlock>
                        <TextBox x:Name="ManualDbKey" PlaceholderText="48b985c8..." />
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ManualDataPath" Header="数据目录（可选，默认自动定位）"
                                     PlaceholderText="C:\Users\你\Documents\xwechat_files\账号目录" />
                            <Button Padding="12,0" Grid.Column="1" Content="浏览…" Click="BrowseDataPath_Click"
                                    Height="32"
                                    ToolTipService.ToolTip="选择该账号的微信数据目录" />
                        </Grid>
                    </StackPanel>
                    <TextBlock x:Name="KeyStatus" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!--  本地引擎模型  -->
                <StackPanel x:Name="PaneModels" Spacing="12" Visibility="Collapsed">
                    <TextBlock FontSize="20" FontWeight="SemiBold">本地 laya 判读</TextBlock>
                    <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="判读只走本机进程内的 laya-multilingual（mmBERT-base，约 700MB，从 HuggingFace convaiinnovations/laya-multilingual 下载 PyTorch 权重，经 NLaya/TorchSharp 推理）：离线可用、不生成文本、消息不出本机。" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Padding="12,0" x:Name="DownloadLayaButton" Height="32" Click="DownloadLaya_Click">下载模型</Button>
                        <Button Padding="12,0" x:Name="CancelLayaButton" Height="32" Click="CancelLaya_Click"
                                IsEnabled="False">
                            取消
                        </Button>
                        <Button Padding="12,0" Click="OpenLayaModelDir_Click" Height="32">打开模型目录</Button>
                    </StackPanel>
                    <ProgressBar x:Name="LayaProgress" Maximum="100" Value="0" />
                    <TextBlock x:Name="LayaModelStatus" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <!--  语音转写  -->
                <StackPanel x:Name="PaneVoice" Spacing="12" Visibility="Collapsed">
                    <TextBlock FontSize="20" FontWeight="SemiBold">语音转写</TextBlock>
                    <ToggleSwitch x:Name="VoiceSwitch" OnContent="启用语音消息转写" OffContent="语音转写：关" />
                    <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="SenseVoiceSmall int8（约 245MB，modelscope 下载）+ 微信同源 Silk 解码，全程本地推理。" />
                    <StackPanel Spacing="4">
                        <TextBlock>模型目录（空 = 文档\JevChatAnalyzer\models\sensevoice，修改需重启）</TextBlock>
                        <TextBox x:Name="VoiceModelDirBox" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Padding="12,0" x:Name="DownloadVoiceButton" Height="32" Click="DownloadVoice_Click">下载语音模型</Button>
                        <Button Padding="12,0" Click="OpenVoiceModelDir_Click" Height="32">打开模型目录</Button>
                    </StackPanel>
                    <ProgressBar x:Name="VoiceProgress" Maximum="100" Value="0" />
                    <TextBlock x:Name="VoiceModelStatus" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <!--  起草回复  -->
                <StackPanel x:Name="PaneDraft" Spacing="12" Visibility="Collapsed">
                    <TextBlock FontSize="20" FontWeight="SemiBold">起草回复</TextBlock>
                    <ToggleSwitch x:Name="DraftSwitch" OnContent="启用起草回复（判读完成后可用）" OffContent="起草回复：关" />
                    <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="调用兼容 OpenAI Chat Completions 的接口生成 3 条候选回复，再由本地 laya 判读选出最合适的一条置顶。会话上下文与判读结论会发送到所填接口，请自行确认服务方。" />
                    <StackPanel Spacing="4">
                        <TextBox x:Name="DraftEndpointBox" Header="接口地址"
                                 PlaceholderText="https://api.deepseek.com/chat/completions" />
                        <TextBlock FontSize="11" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="须为完整的 chat/completions 端点；请求体按 OpenAI 格式构造。" />
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBox x:Name="DraftModelBox" Header="模型名" PlaceholderText="deepseek-chat" />
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBox x:Name="DraftApiKeyEnvBox" Header="API key 所在的环境变量名"
                                 PlaceholderText="LLM_API_KEY" TextChanged="DraftApiKeyEnvBox_TextChanged" />
                        <TextBlock x:Name="DraftKeyHint" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <!--  隐私与写回  -->
                <StackPanel x:Name="PanePrivacy" Spacing="12" Visibility="Collapsed">
                    <TextBlock FontSize="20" FontWeight="SemiBold">隐私与写回</TextBlock>
                    <ToggleSwitch x:Name="WriteBackSwitch" OnContent="自动写回：判读对方消息后入队并实时落库" OffContent="自动写回：关（仅分析，不写库）" />
                    <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="写回把判读结论写进对方那条消息的引用块（不改正文、不新增气泡）。判读后先记账再实时落库；改写前的原文快照留在判读台账里，支持按条撤销与逐条还原到本应用修改之前（不复制整库）。" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Padding="12,0" Click="RestoreAll_Click" Height="32">还原到修改前</Button>
                        <Button Padding="12,0" x:Name="ListWriteBacksButton" Click="ListWriteBacks_Click" Height="32">查看写回台账</Button>
                    </StackPanel>
                    <TextBlock x:Name="WriteBackListText" TextWrapping="Wrap" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="判读台账（判读记录 + 写回状态）以 SQLCipher 加密存储在本机（文件密钥经 DPAPI 绑定当前用户）。" />
                </StackPanel>

                <!--  关于  -->
                <StackPanel x:Name="PaneAbout" Spacing="8" Visibility="Collapsed">
                    <TextBlock FontSize="20" FontWeight="SemiBold">关于</TextBlock>
                    <TextBlock Text="JevChatAnalyzer — 微信 4.x 数据库直读的 Jev 聊天判读工具" />
                    <TextBlock
                        Text="组件：rwk.dll（密钥只读提取）· sqlcipher.dll（微信同源 SQLCipher 3.27.2）· silk_decoder.dll（Silk 解码）· sherpa-onnx（SenseVoice 转写）· NLaya/TorchSharp（本地 laya 判读）"
                        TextWrapping="Wrap" />
                    <TextBlock Text="原始微信数据一律只读；所有写操作均在本应用数据目录内，写回功能除外（显式确认 + 自动备份）。" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Padding="12,0" x:Name="SaveSettingsButton" Click="Save_Click" Height="32"
                            Style="{StaticResource AccentButtonStyle}">
                        保存设置
                    </Button>
                    <TextBlock x:Name="SaveHint" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
