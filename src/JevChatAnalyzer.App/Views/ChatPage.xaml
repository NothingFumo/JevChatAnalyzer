<Page
    x:Class="JevChatAnalyzer.App.Views.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部工具条 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
            <Button x:Name="OpenDataButton" Click="OpenDataButton_Click">打开微信数据</Button>
            <Button x:Name="RefreshButton" Click="RefreshButton_Click" IsEnabled="False">刷新会话</Button>
            <Button x:Name="JudgeButton" Click="JudgeButton_Click" IsEnabled="False" Style="{StaticResource AccentButtonStyle}">判读选中消息</Button>
            <Button x:Name="WriteBackButton" Click="WriteBackButton_Click" IsEnabled="False">写回为引用消息</Button>
            <Button x:Name="RevokeButton" Click="RevokeButton_Click" IsEnabled="False">撤销写回</Button>
            <ProgressRing x:Name="BusyRing" Width="24" Height="24" IsActive="False"/>
        </StackPanel>

        <InfoBar x:Name="Status" Grid.Row="1" IsOpen="False" Severity="Informational" CloseButtonClick="Status_Close"/>

        <!-- 会话列表 + 消息时间线 -->
        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ListView Grid.Column="0" x:Name="SessionList" SelectionChanged="SessionList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="4" Spacing="2">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock FontSize="12" Foreground="Gray">
                                <Run Text="{Binding KindLabel}"/><Run Text=" · "/><Run Text="{Binding CountLabel}"/>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <ScrollViewer Grid.Column="1" x:Name="MessageScroller">
                <ListView x:Name="MessageList" SelectionMode="Single" SelectionChanged="MessageList_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Padding="6" Spacing="2" MaxWidth="640" HorizontalAlignment="Left">
                                <TextBlock FontSize="12" Foreground="Gray">
                                    <Run Text="{Binding Sender}"/><Run Text="  "/><Run Text="{Binding TimeLabel}"/>
                                </TextBlock>
                                <!-- 引用块 -->
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4"
                                        Padding="6,3" Visibility="{Binding QuoteVisibility}">
                                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Text="{Binding QuoteText}" TextWrapping="Wrap"/>
                                </Border>
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </ScrollViewer>
        </Grid>

        <!-- 判读结果卡片 -->
        <Border Grid.Row="3" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8" Padding="12">
            <StackPanel x:Name="VerdictPanel" Spacing="6" Visibility="Collapsed">
                <TextBlock x:Name="VerdictSummary" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <ItemsControl x:Name="VerdictAnswers">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock FontSize="13" Margin="0,1">
                                <Run Text="{Binding Label}" Foreground="Gray"/><Run Text="  "/><Run Text="{Binding Value}"/>
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="VerdictMeta" FontSize="12" Foreground="Gray"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
