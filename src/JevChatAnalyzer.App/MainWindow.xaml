<Window
    x:Class="JevChatAnalyzer.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="JevChatAnalyzer">
    <Grid>
        <!--  Win10 Fluent 标准导航：自适应（窄屏图标栏 / 宽屏展开），设置固定在左下角  -->
        <NavigationView x:Name="Nav"
                        PaneDisplayMode="Auto"
                        OpenPaneLength="220"
                        CompactPaneLength="48"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="True"
                        IsPaneToggleButtonVisible="True"
                        SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="会话与监听" Tag="sessions" Icon="Comment" />
                <NavigationViewItem Content="判读历史" Tag="history" Icon="Clock" />
            </NavigationView.MenuItems>
            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
